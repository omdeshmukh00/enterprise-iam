# =========================================================
# IdentityHub - Enterprise IAM Monorepo Environment Configuration
# =========================================================
# This file documents environment configuration across services.
# Copy appropriate variables to the respective application .env files.
# NEVER commit real credentials, SMTP passwords, database URLs, or secret keys to source control.

# ---------------------------------------------------------
# Identity Server (apps/identity-server/.env)
# ---------------------------------------------------------
NODE_ENV=development
PORT=5000
APP_NAME=IdentityHub
APP_VERSION=1.0.0
APP_BASE_URL=http://localhost:5000
OIDC_ISSUER=http://localhost:5000

# Database Connections
DATABASE_URL="postgresql://user:password@hostname:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@hostname:5432/postgres"

# Cookie & Session Isolation
SSO_SESSION_COOKIE_NAME=identityhub_sso_session
SESSION_COOKIE_NAME=identityhub_sso_session
SESSION_TTL_SECONDS=604800
SESSION_IDLE_TIMEOUT_SECONDS=86400
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PATH=/

# Development OTP Terminal Logging (strictly forbidden in production)
DEV_LOG_AUTH_OTP=false

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Application URLs
ADMIN_CONSOLE_URL=http://localhost:3000
CRM_APP_URL=http://localhost:3001

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASSWORD="app-password"
SMTP_FROM_EMAIL="IdentityHub <user@example.com>"
SMTP_FROM_NAME=IdentityHub

# ---------------------------------------------------------
# Admin Console (apps/admin-console/.env)
# ---------------------------------------------------------
# PORT=3000
# NEXT_PUBLIC_IDENTITY_SERVER_URL=http://localhost:5000
# ADMIN_SESSION_COOKIE_NAME=identityhub_admin_session
# NEXT_PUBLIC_CLIENT_ID=identityhub-admin-console

# ---------------------------------------------------------
# CRM Application (apps/client-apps/crm/.env)
# ---------------------------------------------------------
# PORT=3001
# NEXT_PUBLIC_IDENTITY_SERVER_URL=http://localhost:5000
# NEXT_PUBLIC_IDENTITY_CONSOLE_URL=http://localhost:3000
# CRM_SESSION_COOKIE_NAME=identityhub_crm_session
# NEXT_PUBLIC_CLIENT_ID=identityhub-crm
