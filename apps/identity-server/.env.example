# NODE_ENV=development
# PORT=4000
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/identityhub?schema=public
# APP_BASE_URL=http://localhost:4000
# FRONTEND_URL=http://localhost:3000


# =========================================================
# IdentityHub - Identity Server Environment Configuration
# =========================================================

# ---------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------

NODE_ENV=development

PORT=5000

APP_NAME=IdentityHub
APP_VERSION=1.0.0

# Base URL of the Identity Server
APP_BASE_URL=http://localhost:5000

# Public issuer URL used in OAuth/OIDC
# Production example:
# https://auth.identityhub.app
OIDC_ISSUER=http://localhost:5000


# ---------------------------------------------------------
# DATABASE - SUPABASE POSTGRESQL + PRISMA
# ---------------------------------------------------------

# Runtime/application connection.
# Recommended: Supabase Transaction Pooler URL (port 6543)
#
# Example format:
# postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection used by Prisma CLI / migrations.
#
# Example:
# postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
#
# Or Supabase direct database hostname:
# postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Database SSL
DATABASE_SSL=true


# ---------------------------------------------------------
# AUTHENTICATION / SESSION
# ---------------------------------------------------------

# Session lifetime in seconds
SESSION_TTL_SECONDS=604800

# Idle session timeout in seconds
SESSION_IDLE_TIMEOUT_SECONDS=86400

# Name of the browser central SSO session cookie
SSO_SESSION_COOKIE_NAME=identityhub_sso_session
SESSION_COOKIE_NAME=identityhub_sso_session

# Development OTP terminal logging (DEV ONLY - must be false in prod)
DEV_LOG_AUTH_OTP=false

# Cookie settings
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Leave empty for host-only cookie.
# Production:
# Do NOT set this unless you intentionally need a cross-subdomain cookie.
COOKIE_DOMAIN=

# Cookie path
COOKIE_PATH=/


# ---------------------------------------------------------
# PASSWORD SECURITY
# ---------------------------------------------------------

# Argon2 configuration
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1


# ---------------------------------------------------------
# JWT / TOKEN CONFIGURATION
# ---------------------------------------------------------

# JWT issuer
JWT_ISSUER=http://localhost:5000

# Audience used by access tokens
JWT_AUDIENCE=identityhub-api

# Access token lifetime
JWT_ACCESS_TOKEN_TTL=15m

# ID token lifetime
JWT_ID_TOKEN_TTL=5m

# Refresh token lifetime
JWT_REFRESH_TOKEN_TTL=30d

# Signing algorithm
JWT_ALGORITHM=RS256

# Key identifier used in JWKS
JWT_KEY_ID=identityhub-key-01

# RSA private key used for signing JWTs.
# In a real environment, use your secret manager/platform secrets.
#
# Example format:
# -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
JWT_PRIVATE_KEY=""

# RSA public key exposed through JWKS.
#
# Example format:
# -----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_PUBLIC_KEY=""

JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# ---------------------------------------------------------
# OIDC
# ---------------------------------------------------------

# OpenID Connect issuer
OIDC_ISSUER=http://localhost:5000

# OIDC supported scopes
OIDC_SUPPORTED_SCOPES=openid,profile,email

# OIDC supported claims
OIDC_SUPPORTED_CLAIMS=sub,email,name,given_name,family_name

# UserInfo endpoint
OIDC_USERINFO_URL=http://localhost:5000/oidc/userinfo

# JWKS endpoint
OIDC_JWKS_URL=http://localhost:5000/.well-known/jwks.json


# ---------------------------------------------------------
# OAUTH 2.0
# ---------------------------------------------------------

# Authorization endpoint
OAUTH_AUTHORIZATION_URL=http://localhost:5000/oauth/authorize

# Token endpoint
OAUTH_TOKEN_URL=http://localhost:5000/oauth/token

# Revocation endpoint
OAUTH_REVOCATION_URL=http://localhost:5000/oauth/revoke

# Introspection endpoint
OAUTH_INTROSPECTION_URL=http://localhost:5000/oauth/introspect

# Authorization code lifetime
OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=300

# Require PKCE for public clients
OAUTH_REQUIRE_PKCE=true

# Allowed response types
OAUTH_RESPONSE_TYPES=code

# Allowed grant types
OAUTH_GRANT_TYPES=authorization_code,refresh_token


# ---------------------------------------------------------
# SECURITY
# ---------------------------------------------------------

# Generate strong random values for production.
#
# Used for application-level cryptographic operations.
APP_ENCRYPTION_KEY=""

# CSRF protection secret
CSRF_SECRET=""

# General security secret
SECURITY_SECRET=""

# Number of failed login attempts before rate limiting
LOGIN_MAX_ATTEMPTS=5

# Login rate limit window
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# General API rate limit
API_RATE_LIMIT_WINDOW_SECONDS=900
API_RATE_LIMIT_MAX_REQUESTS=100


# ---------------------------------------------------------
# CORS
# ---------------------------------------------------------

# Comma-separated list of allowed origins
#
# Development:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Production example:
# CORS_ALLOWED_ORIGINS=https://admin.identityhub.app,https://crm.identityhub.app,https://analytics.identityhub.app


# ---------------------------------------------------------
# FRONTEND / APPLICATION URLS
# ---------------------------------------------------------

ADMIN_CONSOLE_URL=http://localhost:3000

CRM_APP_URL=http://localhost:3001

ANALYTICS_APP_URL=http://localhost:3002

HR_APP_URL=http://localhost:3003


# ---------------------------------------------------------
# EMAIL / GMAIL SMTP
# ---------------------------------------------------------

SMTP_HOST=smtp.gmail.com

# 587 = STARTTLS
# 465 = SSL/TLS
SMTP_PORT=587

# false for port 587
# true for port 465
SMTP_SECURE=false

SMTP_USER=yourgmail@gmail.com

# Gmail App Password
# NEVER use your normal Gmail account password here.
SMTP_PASSWORD=""

SMTP_FROM_EMAIL=yourgmail@gmail.com

SMTP_FROM_NAME=IdentityHub


# ---------------------------------------------------------
# EMAIL LINKS
# ---------------------------------------------------------

EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email

PASSWORD_RESET_URL=http://localhost:3000/reset-password

SECURITY_NOTIFICATION_URL=http://localhost:3000/security


# ---------------------------------------------------------
# MFA / TOTP
# ---------------------------------------------------------

MFA_ISSUER=IdentityHub

MFA_DIGITS=6

MFA_PERIOD=30

# Number of recovery codes generated per user
MFA_RECOVERY_CODE_COUNT=10


# ---------------------------------------------------------
# LOGGING
# ---------------------------------------------------------

LOG_LEVEL=debug

LOG_FORMAT=pretty


# ---------------------------------------------------------
# ADMIN BOOTSTRAP
# ---------------------------------------------------------

# Used only for initial development/seeding.
# DO NOT commit real values.

INITIAL_ADMIN_EMAIL=admin@example.com

INITIAL_ADMIN_PASSWORD="ChangeMeImmediately"


# ---------------------------------------------------------
# REDIRECT / PUBLIC SECURITY SETTINGS
# ---------------------------------------------------------

# Maximum allowed clock skew for token validation
TOKEN_CLOCK_SKEW_SECONDS=30

# Enable secure headers
ENABLE_SECURITY_HEADERS=true

# Trust proxy when deployed behind Render/Nginx/etc.
TRUST_PROXY=false


# ---------------------------------------------------------
# DEVELOPMENT
# ---------------------------------------------------------

DEBUG=false