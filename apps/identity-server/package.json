{
  "name": "identity-server",
  "version": "1.0.0",
  "private": true,
  "description": "IdentityHub Core Backend Identity Server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
